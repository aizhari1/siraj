# Public (safe in the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Never prefix with NEXT_PUBLIC_ and never import in client components.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta (Facebook / Instagram) — server only. Create app at https://developers.facebook.com/apps/
META_APP_ID=
META_APP_SECRET=

# Optional: protect /api/social/run-scheduled if not using Vercel Cron header alone
CRON_SECRET=
